# xb-account configuration (authoritative list: README.md).
# No secrets in this file: every secret is a file under /run/xb.
XB_LISTEN_ADDR=0.0.0.0:REPLACE_PORT
XB_TLS_CERT_FILE=/run/xb/server.crt
XB_TLS_KEY_FILE=/run/xb/server.key
# Dedicated CA that signs xb-auth and xb-gateway client certificates.
XB_CLIENT_CA_FILE=/run/xb/client-ca.crt
XB_CORE_ADDR=openpak-account:REPLACE_CORE_PORT
XB_CORE_KEY_FILE=/run/xb/core.key
XB_PEPPER_FILE=/run/xb/pepper.hex
# Postgres DSN (schema xb_account of the "xbox" database); required. Real value lives in the deploy env, never in git.
XB_ACCOUNT_DATABASE_URL=postgres://xbox:REPLACE@openpak-postgres:5432/xbox?sslmode=disable
# Core's gRPC is plaintext on the private container network today; remove this
# line and set XB_CORE_CA_FILE / XB_CORE_SERVER_NAME once core offers TLS.
XB_CORE_PLAINTEXT_INTERNAL=1

# Optional native service 5 (account signup requests, reservename only) for the gateway,
# gRPC over the same mTLS. Gateway: XBGW_BACKENDS=5=<host>:<port>.
# XB_SVC5_ADDR=0.0.0.0:26113
# XB_SVC5_TEST_ALLOW_OWNER=1   # TEST ONLY: skip the one-user-per-account refusal

# Account erasure (card #120): shared key; the endpoint is not served while unset. Listens on ERASE_ADDR (container network only, never publish).
# ACCOUNT_ERASE_KEY=
# ERASE_ADDR=:9099
